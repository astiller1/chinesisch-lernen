// Cloudflare Worker: App (dist/) + /api (Schlüssel für Claude und Azure Speech, nur mit Cloudflare Access).
// Veröffentlichen: npm run deploy. Einrichtung: README.md.
{
  "name": "chinesisch-lernen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // KI kostenlos: lokales Qwen über den Tunnel, sonst Qwen auf Workers AI (Tageskontingent).
  "ai": { "binding": "AI" },
  "vars": { "OLLAMA_URL": "https://ollama.jan-lab.de", "OLLAMA_MODEL": "qwen-schnell" },
  "routes": [{ "pattern": "chinesisch.jan-lab.de", "custom_domain": true }],
  "workers_dev": false
}
