  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
